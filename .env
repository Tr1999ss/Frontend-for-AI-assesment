# Spring Boot backend the dev server proxies to. 9000 collides with a Docker container on this
# machine, so the backend is run with --server.port=8091. Override in .env.local if needed.
BACKEND_URL=http://localhost:8091

# Keycloak (compose.yaml in the backend repo). Login redirects go here directly;
# token calls are proxied by the dev server under /realms.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=generic
VITE_OIDC_CLIENT_ID=generic-cli
